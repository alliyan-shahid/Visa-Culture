.mel-wrap #final-cta {
  width: 100%;
  padding: 0 !important;
  background: linear-gradient(125deg,#082b45 0%,#0a4d8f 62%,#0b756d 145%) !important;
}

.mel-wrap #final-cta > .mx-auto {
  width: 100%;
  max-width: none;
  padding: 0;
}

.mel-wrap #final-cta > .mx-auto > div {
  min-height: 25rem;
  padding: clamp(4rem,7vw,6.25rem) max(1.25rem,calc((100vw - 78rem)/2 + 3rem));
  background: transparent;
}

.mel-wrap #final-cta > .mx-auto > div > .relative.z-10 {
  width: 100%;
  max-width: 78rem;
  margin: 0 auto;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: clamp(2rem,8vw,9rem);
  text-align: left;
}

.mel-wrap #final-cta > .mx-auto > div > .relative.z-10 > .absolute,.mel-wrap #final-cta > .mx-auto > div > .relative.z-10 > div:nth-child(3) {
  display: none;
}

.mel-wrap #final-cta > .mx-auto > div > .relative.z-10 > div:first-child {
  flex: 1 1 auto;
  max-width: 43rem;
}

.mel-wrap #final-cta > .mx-auto > div > .relative.z-10 > div:nth-child(2) {
  display: flex;
  flex: 0 0 auto;
  flex-direction: row;
  align-items: center;
  gap: .7rem;
  padding: 0 0 .2rem;
}

.mel-wrap #final-cta h2 {
  max-width: 39rem;
  margin-top: .7rem;
  color: #fff;
  font-family: Manrope,sans-serif;
  font-size: clamp(2.3rem,4.3vw,4.6rem);
  font-weight: 800;
  letter-spacing: -.075em;
  line-height: .96;
}

.mel-wrap #final-cta > .mx-auto > div > .relative.z-10 > div:first-child > p:last-child {
  max-width: 38rem;
  margin-top: .9rem;
  color: rgba(255,255,255,.74);
  font-size: .9rem;
  line-height: 1.8;
}

.mel-wrap #final-cta .text-blue-200 {
  color: #e1b35f !important;
}

.mel-wrap #final-cta .premium-btn-primary {
  border: 1px solid #e1b35f;
  background: #e1b35f;
  color: #172331;
  box-shadow: none;
}

.mel-wrap #final-cta .premium-btn-secondary {
  border: 1px solid rgba(255,255,255,.52);
  background: transparent;
  color: #fff;
}
