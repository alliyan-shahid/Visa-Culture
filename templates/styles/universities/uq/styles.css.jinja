:root {
  --hero-from: #041f3c;
  --hero-to: #0c4a6e;
  --accent: #38bdf8;
  --panel: rgba(255,255,255,0.12);
}

.hero-section {
  background: radial-gradient(circle at top right, rgba(56,189,248,0.22), transparent 30%), linear-gradient(135deg, var(--hero-from), var(--hero-to));
}

.section-card {
  background: var(--panel);
  border: 1px solid rgba(255,255,255,0.1);
  opacity: 0;
  animation: fadeInUp 0.9s ease-out forwards;
  animation-delay: 0.2s;
}

.hero-highlight {
  color: var(--accent);
  text-shadow: 0 0 24px rgba(56,189,248,0.28);
}

.accent-btn {
  background: var(--accent);
  color: #0f172a;
  transition: transform 0.28s ease, box-shadow 0.28s ease;
}

.accent-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 18px 36px rgba(56,189,248,0.22);
}

.accordion-button {
  border: 1px solid rgba(255,255,255,0.14);
  background: rgba(255,255,255,0.08);
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(28px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.hero-fade-in {
  opacity: 0;
  animation: fadeInUp 1s ease-out forwards;
}

.hero-uq {
  position: relative;
  overflow: hidden;
  height: 70vh;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: unset !important;
}

@media (min-width: 768px) {
  .hero-uq {
    height: 79vh;
  }
}

@media (min-width: 1024px) {
  .hero-uq {
    height: 85vh;
  }
}

.hero-uq .absolute.inset-0 {
  z-index: 0;
}

.hero-uq .absolute.inset-0.bg-slate-950\/45 {
  display: none;
}

@media (min-width: 1024px) {
  .hero-uq .absolute.inset-0.bg-slate-950\/45 {
    display: block;
    z-index: 2;
  }
}

.hero-uq .relative.mx-auto {
  z-index: 10;
  position: relative;
}

@media (max-width: 767px) {
  .hero-uq .relative.mx-auto {
    display: none !important;
  }
}

.uq-front-image {
  display: none !important;
}

@media (min-width: 1024px) {
  .uq-front-image {
    display: block !important;
  }
}

.hero-overlay {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at top left, rgba(255,210,0,0.18), transparent 28%), radial-gradient(circle at bottom right, rgba(96,165,250,0.14), transparent 30%);
  pointer-events: none;
  z-index: 1;
}

@media (max-width: 767px) {
  .hero-overlay {
    display: none !important;
  }
}

.btn-uq {
  background: linear-gradient(90deg, #1e40af, #2d6cdf);
  color: white;
}

.panel-soft {
  background: rgba(255,255,255,0.94);
  border: 1px solid rgba(15,23,42,0.08);
  box-shadow: 0 28px 80px rgba(15,23,42,0.08);
}

.btn-uq:hover {
  transform: translateY(-2px);
}

@media (max-width: 767px) {
  .hero-uq {
    padding-top: 4rem;
    padding-bottom: 4rem;
  }
}
