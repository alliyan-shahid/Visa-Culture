.mel-wrap #final-cta {
  width: 100%;
  padding: 0 !important;
  background: linear-gradient(125deg,#082b45 0%,#0a4d8f 62%,#0b756d 145%) !important;
}

.mel-wrap #final-cta > .mx-auto {
  width: 100%;
  max-width: none;
  padding: 0;
}

.mel-wrap #final-cta > .mx-auto > div {
  min-height: 25rem;
  padding: clamp(4.5rem,8vw,7rem) max(1.25rem,calc((100vw - 78rem)/2 + 3rem)) clamp(3.75rem,6vw,5.5rem);
  background: transparent;
}

.mel-wrap #final-cta > .mx-auto > div > .relative.z-10 {
  width: 100%;
  max-width: 78rem;
  margin: 0 auto;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: clamp(2rem,8vw,9rem);
  text-align: left;
}

.mel-wrap #final-cta > .mx-auto > div > .relative.z-10 > .absolute, .mel-wrap #final-cta > .mx-auto > div > .relative.z-10 > div:nth-child(3) {
  display: none;
}

.mel-wrap #final-cta > .mx-auto > div > .relative.z-10 > div:first-child {
  flex: 1 1 auto;
  max-width: 43rem;
}

.mel-wrap #final-cta > .mx-auto > div > .relative.z-10 > div:nth-child(2) {
  display: flex;
  flex: 0 0 auto;
  flex-direction: row;
  align-items: center;
  gap: .7rem;
  padding: 0 0 .2rem;
}

.mel-wrap #final-cta h2 {
  max-width: 39rem;
  margin-top: .7rem;
  color: #fff;
  font-family: Manrope,sans-serif;
  font-size: clamp(2.3rem,4.3vw,4.6rem);
  font-weight: 800;
  letter-spacing: -.075em;
  line-height: .96;
}

.mel-wrap #final-cta > .mx-auto > div > .relative.z-10 > div:first-child > p:last-child {
  max-width: 38rem;
  margin-top: .9rem;
  color: rgba(255,255,255,.74);
  font-size: .9rem;
  line-height: 1.8;
}

.mel-wrap #final-cta .text-blue-200 {
  color: #e1b35f !important;
}

.mel-wrap #final-cta .premium-btn-primary {
  border: 1px solid #e1b35f;
  background: #e1b35f;
  color: #172331;
  box-shadow: none;
}

.mel-wrap #final-cta .premium-btn-secondary {
  border: 1px solid rgba(255,255,255,.52);
  background: transparent;
  color: #fff;
}

.melbourne-cta {
  width: 100vw;
  margin-left: calc(50% - 50vw);
  margin-right: calc(50% - 50vw);
  padding: clamp(3.75rem,7vw,6.5rem) max(1.25rem,calc((100vw - 78rem)/2 + 3rem)) !important;
  background: linear-gradient(125deg,#082b45 0%,#0a4d8f 62%,#0b756d 145%);
  color: #fff;
}

.melbourne-cta__inner {
  max-width: 78rem;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: clamp(2rem,8vw,9rem);
}

.melbourne-cta__copy {
  max-width: 44rem;
}

.melbourne-cta__label {
  margin: 0;
  color: #bfe0ff;
  font-size: .7rem;
  font-weight: 800;
  letter-spacing: .2em;
  text-transform: uppercase;
}

.melbourne-cta__copy h2 {
  max-width: 36rem;
  margin: .85rem 0 0;
  color: #fff;
  font-family: Manrope,sans-serif;
  font-size: clamp(2.2rem,3.9vw,4rem);
  font-weight: 800;
  letter-spacing: -.07em;
  line-height: .98;
}

.melbourne-cta__copy > p:last-child {
  max-width: 36rem;
  margin: 1.15rem 0 0;
  color: #d9eafa;
  font-size: .88rem;
  line-height: 1.8;
}

.melbourne-cta__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: .3rem;
  min-height: 3.1rem;
  padding: .85rem 1.45rem;
  border: 1px solid #f4b942;
  border-radius: 999px;
  background: #f4b942;
  color: #173f3a;
  font-size: .78rem;
  font-weight: 800;
  text-decoration: none;
  white-space: nowrap;
}

.melbourne-cta__button:hover, .melbourne-cta__button:focus-visible {
  border-color: #ffd477;
  background: #ffd477;
  color: #173f3a;
  outline: none;
}

.mel-wrap #final-cta.melbourne-cta {
  padding-top: clamp(4rem,7vw,6.25rem) !important;
  padding-bottom: clamp(4rem,7vw,6.25rem) !important;
}
