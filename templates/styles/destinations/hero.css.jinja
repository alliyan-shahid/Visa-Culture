/*Single fixed destination hero image: homepage framing without carousel movement.*/

.au-guide__hero {
  min-height: clamp(36rem,72vh,48rem);
  background-color: transparent;
  background-image: url("{{ url_for('static', filename=desktop_hero) }}");
  background-position: center;
  background-size: cover;
  background-repeat: no-repeat;
  background-blend-mode: normal;
  filter: none;
  box-shadow: none;
}

.au-guide__hero::before,.au-guide__hero::after {
  content: none !important;
  display: none !important;
  background: none !important;
}

@media (min-width:651px) {
  .au-guide__hero {
    min-height: 0;
    height: auto;
    aspect-ratio: {{ desktop_ratio }};
    padding: 0;
    background-size: 100% 100%;
  }
}

.au-guide__band {
  margin-top: clamp(4rem,8vw,8rem);
}

@media (max-width:900px) {
  .au-guide__settle-list {
    grid-template-columns: 1fr;
  }

  .au-guide__settle-row:nth-child(even) {
    padding-right: 0;
    padding-left: 0;
    border-left: 0;
  }
}

@media (max-width:650px) {
  .au-guide__shell {
    padding-top: 0;
  }

  .au-guide__hero {
    margin: 0 -1rem;
    min-height: 0;
    padding: 20px 1rem 3rem;
    background-position: center;
  }

  .au-guide__title {
    font-size: clamp(2.65rem,12vw,4rem);
  }

  .au-guide__settle-row {
    min-height: 0;
  }
}
