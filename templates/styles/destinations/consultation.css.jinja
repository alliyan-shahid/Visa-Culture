/*Closing CTA: a clear, full-width final step that for the destination guide.*/

.au-guide__cta {
  position: relative;
  width: 100vw;
  margin-left: calc(50% - 50vw);
  margin-right: calc(50% - 50vw);
  margin-top: 0;
  padding: clamp(3.5rem,7vw,6.5rem) max(1.1rem,calc((100vw - 78rem) / 2 + 3rem));
  overflow: hidden;
  align-items: center;
  border-top: 0;
  background: linear-gradient(125deg,#082b45 0%,#0a4d8f 62%,#0b756d 145%);
  color: #fff;
}

.au-guide__cta:after {
  display: none;
}

.au-guide__cta > div,.au-guide__cta > a {
  position: relative;
  z-index: 1;
}

.au-guide__cta .au-guide__label {
  color: #bfe0ff;
}

.au-guide__cta h2 {
  max-width: 39rem;
  margin-top: .75rem;
  color: #fff;
  font-size: clamp(2.2rem,4.5vw,4.6rem);
  letter-spacing: -.07em;
  line-height: .96;
}

.au-guide__cta p {
  max-width: 38rem;
  color: #d9eafa;
  font-size: .9rem;
  line-height: 1.8;
}

.au-guide__cta .au-guide__button {
  flex: 0 0 auto;
  border-color: #f4b942;
  background: #f4b942;
  color: #173f3a;
  box-shadow: 0 .9rem 1.9rem rgba(0,0,0,.2);
}

.au-guide__cta .au-guide__button:hover,.au-guide__cta .au-guide__button:focus-visible {
  border-color: #ffd477;
  background: #ffd477;
  color: #173f3a;
}

.au-guide__band {
  background: linear-gradient(135deg,#0b756d 0%,#087875 58%,#0a4d8f 100%);
}

.au-guide__band .au-guide__label {
  color: #f6d98a;
}

.au-guide__band .au-guide__section-copy {
  color: #d5f1ec;
}

@media (max-width:650px) {
  .au-guide__cta {
    margin-top: 0;
    padding-right: 1rem;
    padding-left: 1rem;
  }

  .au-guide__cta h2 {
    font-size: clamp(2.2rem,10vw,3.25rem);
  }
}

@media (max-width:650px) {
  .au-guide__hero {
    display: block;
    min-height: 0;
    height: auto;
    aspect-ratio: {{ mobile_ratio }};
    padding: 0;
    background-image: url("{{ url_for('static', filename=mobile_hero) }}");
    background-position: center;
    background-size: 100% 100%;
  }

  .au-guide__hero > div,.au-guide__hero .au-guide__glance {
    display: none !important;
  }

  .au-guide__hero:after {
    display: none;
  }
}

@media (max-width:650px) {
  .au-guide {
    width: 100%;
    overflow-x: hidden;
  }

  .au-guide__shell {
    width: 100%;
    max-width: 100%;
    padding: 0 1rem;
  }

  .au-guide__section {
    padding-top: 3.5rem;
  }

  .au-guide__section-head {
    display: block;
    gap: 0;
    padding-bottom: 1.25rem;
  }

  .au-guide__heading {
    max-width: 20rem;
    font-size: clamp(1.95rem,9.5vw,3rem);
    line-height: .98;
  }

  .au-guide__section-copy {
    max-width: 100%;
    margin-top: 1rem;
    font-size: .82rem;
    line-height: 1.75;
  }

  .au-guide__band {
    margin-top: 3.5rem;
    padding: 3.5rem 1rem;
  }

  .au-guide__settle {
    margin-top: 3.5rem;
    padding: 3.5rem 1rem;
  }

  .au-guide__network {
    padding: 3.5rem 1rem;
  }

  .au-guide__network-list {
    margin-top: 1.25rem;
  }

  .au-guide__cta {
    padding: 3.5rem 1rem;
  }

  .au-guide__cta h2 {
    max-width: 20rem;
  }

  .au-guide__cta p {
    max-width: 100%;
    font-size: .82rem;
  }

  .au-guide__button {
    min-height: 3rem;
  }
}

@media (max-width:650px) {
  .au-guide__cta h2 {
    max-width: 18rem;
    font-size: clamp(1.8rem,8.5vw,2.6rem);
    line-height: 1.02;
    letter-spacing: -.055em;
  }

  .au-guide__cta {
    padding-top: 3rem;
    padding-bottom: 3rem;
  }
}
